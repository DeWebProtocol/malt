{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deweb.world/schemas/malt/client-root-materialization/v1/client-root-materialization.schema.json",
  "title": "MALT Client Root Materialization v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "maps"
  ],
  "properties": {
    "profile": {
      "const": "malt.client-root-materialization/v1"
    },
    "maps": {
      "type": "array",
      "maxItems": 65536,
      "items": {
        "$ref": "#/$defs/map"
      }
    }
  },
  "$defs": {
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_id",
        "root",
        "entries"
      ],
      "properties": {
        "transition_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "root": {
          "$ref": "#/$defs/cid"
        },
        "entries": {
          "type": "array",
          "maxItems": 4194304,
          "items": {
            "$ref": "#/$defs/entry"
          }
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "cid"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "cid": {
          "$ref": "#/$defs/cid"
        }
      }
    },
    "cid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  }
}
